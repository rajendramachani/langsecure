[flake8]
# E111: Nutanix uses 2 space indent
# E114: Nutanix uses 2 space indent
# E12: continuation line indents are difficult to enforce
# E121: continuation line under-indented for hanging indent
# E125: continuation line with same indent as next logical line
# E128: continuation line under-indented for visual indent
# E402: Nutanix files do import all over the place
# E731: do not assign a lambda expression, use a def
# W503: is now deprecated for w504
# ignore = E111, E114, E12, E121, E125, E128, E402, E731, W503
# max-line-length = 79
show-source = True
statistics = True
# Tools is python 3, flake8 currently checks python2
# exclude = 
  # Tools is python 3, flake8 currently checks python2
  # tools/checkjson.py,
  # .git
